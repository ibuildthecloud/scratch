%!PS
% stamps.ps: a stamping canvas in PostScript. Pick a shape, click the
% canvas, and Ghostscript draws it there: a fractal tree, a Koch
% snowflake, a spirograph or a glyph from one of its own fonts.
%
%	gpuifs -t Stamps --dir ALPINE:#L sh -c \
%	    "exec gs -q -dNODISPLAY --permit-file-all='/9/mnt/gpui/*' stamps.ps </9/mnt/gpui/events"
%
% --permit-file-all lets gs, which runs with -dSAFER, write the tree.
%
% gs is a Linux program, so it runs in the h9 machine on an Alpine root
% (ALPINE is a tree with ghostscript installed) and sees the gpuifs tree
% at /9/mnt/gpui. PostScript opens the tree's files itself with the file
% operator: it makes the window, writes the screen as a tree document,
% and writes the canvas's ops. The one thing it can't do is read events
% from a named file: gs reads named files with fread, which waits for a
% whole buffer, so an event would sit there until 8 KiB of them came in.
% Its %stdin is read a line at a time, so the shell's one job is to put
% the events file on stdin.
%
% The shapes are drawn with ordinary PostScript path operators (moveto,
% lineto, rlineto, arc, charpath, with rotate and scale in the CTM), on
% the null device. pathforall then walks the finished path in device
% space and writes it as an SVG-style canvas path, so GPUI paints what
% PostScript would have. The canvas is the stamps list, re-rendered into
% ops on every change; undo just drops the last stamp.

/base (/9/mnt/gpui) def
/ident matrix def
ident setmatrix		% user space is device space is canvas space: y down
/min { 2 copy gt { exch } if pop } def
/cat { % (a) (b) -> (ab)
	exch dup length 2 index length add string
	dup dup 4 2 roll copy length 4 -1 roll putinterval
} def
/at { base exch cat } def	% path in the tree
/spit { % (path) (text) -> write the text to the file, then close it
	exch at (w) file dup 3 -1 roll writestring closefile
} def

% ---- The window ------------------------------------------------------------

(/ctl) (window main title=Stamps size=900,640 min=520,400 pos=center\n) spit
(/keymap) (cmd-z undo\n) spit
(/windows/main/root/tree) (div root  style='v_flex size_full bg=background'
  toolbar bar
    button-group shape  value=twig  tag=shape
      button twig  label=Tree
      button flake  label=Snowflake
      button spiro  label=Spirograph
      button glyph  label=Glyph
    separator s1  dir=v
    text dl  text=Detail  style='text_sm text_color=muted_foreground'
    slider depth  min=1  max=8  value=6  style=w=140  tag=depth
    spacer sp
    button undo  icon=undo  style='ghost sm'  tag=undo  tooltip='Undo (cmd-z)'
    button clear  icon=trash  label=Clear  style='ghost sm'  tag=clear
  canvas c  style='flex_1 cursor_crosshair'  on=click
) spit

% ---- Writing ops -----------------------------------------------------------

/out null def
/W { out exch writestring } def
/I { 16 string cvs W } def
/N { 10 mul round 10 div dup dup cvi eq { cvi } if 16 string cvs W } def
/P { transform exch N (,) W N } def	% a user-space point, as canvas x,y
/emitpath { % writes the current path's segments, in device space
	{ ( M) W P } { ( L) W P }
	{ ( C) W 6 -2 roll P (,) W 4 -2 roll P (,) W P } { ( Z) W }
	pathforall
} def
/hexd (0123456789abcdef) def
/C { (x) dup 0 4 -1 roll put W } def
/H { 255 mul round cvi dup -4 bitshift hexd exch get C 15 and hexd exch get C } def
/rgb { % h s b -> writes #rrggbb
	sethsbcolor currentrgbcolor (#) W 3 -1 roll H exch H H
} def
/item { % (kind) id-proc: starts an ops line "kind sN..."
	exch W ( s) W i I exec
} def

% ---- Shapes: each draws at x y with detail d and hue h ---------------------
% A shape is the procedure named by its button (a node can't be called tree,
% which is a file in every node, so the tree is twig).

% Fractal tree: each branch is a line, then two smaller trees, turned
% left and right. The CTM is saved with currentmatrix, not gsave, because
% grestore would throw away the path we are building.
/leaves [] def
/branch { % len depth
	dup 0 le {
		pop pop
		/leaves [ leaves aload pop 0 0 transform ] def
	} {
		matrix currentmatrix 3 1 roll
		0 0 moveto 1 index 0 lineto
		1 index 0 translate
		24 rotate 1 index 0.72 mul 1 index 1 sub branch
		-50 rotate 1 index 0.68 mul 1 index 1 sub branch
		pop pop setmatrix
	} ifelse
} def
/twig {
	/leaves [] def
	newpath x y translate -90 rotate 70 d 1 add branch ident setmatrix
	(path) {} item emitpath ( stroke=) W h 0.55 0.45 rgb ( width=2 cap=round\n) W
	0 2 leaves length 2 sub {
		/j exch def
		(circle) { (l) W j I } item ( ) W leaves j get N ( ) W leaves j 1 add get N
		( 3 fill=) W h 0.33 add dup 1 gt { 1 sub } if 0.45 1 rgb ( opacity=0.85\n) W
	} for
} def

% Koch snowflake: three Koch curves, turning -120 between them.
/koch { % len depth
	dup 0 le { pop 0 rlineto } {
		1 sub exch 3 div exch
		2 copy koch 60 rotate 2 copy koch -120 rotate 2 copy koch 60 rotate koch
	} ifelse
} def
/flake {
	newpath x y translate 1 -1 scale
	/s 150 def
	s -2 div s 3 sqrt mul 6 div moveto
	3 { s d 5 min koch -120 rotate } repeat closepath ident setmatrix
	(path) {} item emitpath ( fill=) W h 0.5 1 rgb ( opacity=0.35 stroke=) W h 0.8 0.7 rgb ( width=1.5\n) W
} def

% Spirograph: a hypotrochoid, the wheel's radius set by the detail.
/gcd { { dup 0 eq { pop exit } if exch 1 index mod } loop } def
/spiro {
	/R 90 def /r [ 50 54 56 60 63 66 70 75 ] d 1 sub get def /p r 0.8 mul def
	/k R r sub r div def
	newpath
	0 3 360 r R r gcd idiv mul {
		/t exch def
		R r sub t cos mul p t k mul cos mul add x add
		R r sub t sin mul p t k mul sin mul sub y add
		t 0 eq { moveto } { lineto } ifelse
	} for closepath
	(path) {} item emitpath ( stroke=) W h 0.7 0.8 rgb ( width=1.2\n) W
} def

% Glyph: an outline from Ghostscript's own fonts, flipped into the canvas's
% y-down space. charpath leaves the outline as a path, curves and all.
/glyphs [ (&) /ZapfChancery-MediumItalic (\247) /Palatino-Italic (@) /Times-BoldItalic
	(\266) /Palatino-Roman (?) /NewCenturySchlbk-Italic (g) /Times-Italic ] def
/glyph {
	/g glyphs i 6 mod 2 mul get def
	/sz 50 d 14 mul add def
	glyphs i 6 mod 2 mul 1 add get findfont sz scalefont setfont
	newpath x y translate 1 -1 scale
	g stringwidth pop -2 div sz -0.3 mul moveto
	g false charpath ident setmatrix
	(path) {} item emitpath ( fill=) W h 0.75 0.75 rgb (\n) W
} def

% ---- The canvas ------------------------------------------------------------

/stamps [] def		% [shape x y detail hue] per stamp, oldest first
/title {
	/Times-BoldItalic findfont 40 scalefont setfont
	newpath 24 60 translate 1 -1 scale 0 0 moveto (PostScript) false charpath ident setmatrix
	(path title) W emitpath ( fill=muted_foreground opacity=0.5\n) W
	/Helvetica findfont 14 scalefont setfont
	newpath 26 84 translate 1 -1 scale 0 0 moveto (pick a shape, click to stamp it) false charpath ident setmatrix
	(path hint) W emitpath ( fill=muted_foreground opacity=0.6\n) W
} def
/render {
	(/windows/main/root/c/ops) at (w) file /out exch def
	(rect bg 0 0 4000 4000 fill=background\n) W
	title
	0 1 stamps length 1 sub {
		/i exch def
		stamps i get aload pop /h exch def /d exch def /y exch def /x exch def
		cvx exec
	} for
	out closefile
} def
render

% ---- Events ----------------------------------------------------------------

/attr { % line (key) -> value or null
	search { pop pop ( ) search { exch pop exch pop } if } { pop null } ifelse
} def
/has { search { pop pop pop true } { pop false } ifelse } def
/num { token pop exch pop } def
/shape /twig def
/detail 6 def
/ev (%stdin) (r) file def
/buf 8192 string def
/undo { stamps length 0 gt { /stamps stamps 0 stamps length 1 sub getinterval def render } if } def
{
	ev buf readline not { pop exit } if
	/line exch def
	/kind line ( ) search { exch pop exch pop } if def	% the event's name
	kind (click) eq {
		line ( node=root/c ) has {
			/stamps [ stamps aload pop
				[ shape line ( x=) attr num line ( y=) attr num detail
				  stamps length 0.618034 mul dup floor sub ] ] def
			render
		} if
		line ( tag=clear ) has { /stamps [] def render } if
		line ( tag=undo ) has { undo } if
	} if
	kind (action) eq { line ( id=undo ) has { undo } if } if
	kind (change) eq {
		line ( tag=shape ) has { /shape line ( value=) attr cvn def } if
		line ( tag=depth ) has { /detail line ( value=) attr num round cvi def } if
	} if
	kind (close) eq kind (quit) eq or { exit } if
} loop
quit
