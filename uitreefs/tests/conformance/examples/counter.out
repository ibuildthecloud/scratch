-- window main Counter
div root  : h_flex size_full items_center justify_center gap=20 bg=background
  div dec  tag=dec  on=click  : size=40 flex items_center justify_center rounded_full border_1 border_color=border text_xl cursor_pointer hover:bg=accent active:bg=muted
    text t  text=−
  text n  text=0  : text_3xl font_semibold w=72 text_center
  div inc  tag=inc  on=click  : size=40 flex items_center justify_center rounded_full border_1 border_color=border text_xl cursor_pointer hover:bg=accent active:bg=muted
    text t  text=+
-- menu Counter
item inc    label=Increment  key==
item dec    label=Decrement  key=-
sep
item reset  label=Reset      key=0
-- keys
=      inc
-      dec
0      reset
-- stderr
