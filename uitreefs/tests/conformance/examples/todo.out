-- window main Todos
div root  : v_flex size_full p=24 gap=12 bg=background
  text h  text=Todos  : text_2xl font_semibold
  input new  cleanable  placeholder='What needs to be done?'  tag=add
  scroll body  : flex_1 overflow_y_scroll
    div items  : v_flex gap=2
    empty none  title='Nothing to do'  description='Add a task above.'  icon=inbox
  div foot  : h_flex items_center gap=8 pt=8 border_t_1 border_color=border
    text count  text='0 items left'  : text_sm text_color=muted_foreground flex_1
    tabs filter  value=all  tag=filter  : segmented sm
      tab all  label=All
      tab active  label=Active
      tab done  label=Done
    button clear  label='Clear completed'  tag=clear  : ghost sm
-- keys
-- stderr
