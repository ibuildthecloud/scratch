-- window main Notes
div root  : h_flex items_stretch size_full
  div nav  : v_flex w=220 border_r_1 border_color=border
    list notes  searchable  selectable  tag=pick
  div page  : v_flex flex_1
    toolbar bar
      button save  label=Save  icon=check  tag=save  : ghost sm
      button del  label=Delete  icon=trash  tag=del  : ghost sm danger
    editor body  soft_wrap  language=markdown  : flex_1
-- overlay main/sure
alert-dialog sure  title='Delete this note?'  confirm=Delete  cancel=Keep  variant=danger  tag=sure
-- menu File
item new label=New key=cmd-n
item save label=Save key=cmd-s
sep
item del label=Delete… key=cmd-backspace
sep
item quit label=Quit key=cmd-q
-- keys
cmd-s save
cmd-n new
cmd-backspace del
-- stderr
