-- window main Chat
div root  : v_flex size_full bg=background
  div head  : h_flex items_center gap=10 px=16 py=10 border_b_1 border_color=border
    avatar a  name=Eliza  : sm
    div n  : v_flex flex_1
      text name  text=Eliza  : font_semibold
      text st  text=online  : text_xs text_color=muted_foreground
    button raw  icon=file-text  tag=raw  tooltip=Transcript  : ghost sm
    button clear  icon=trash  tag=clear  tooltip='Clear chat'  : ghost sm
  message-list msgs  items=<<END  : flex_1 p=16
m1 assistant HH:MM
Hello, I'm **Eliza**. How are you feeling today?


  END
  div compose  : h_flex gap=8 p=12 border_t_1 border_color=border
    input in  placeholder='Message Eliza…'  tag=send  : flex_1
    button go  icon=send  tag=send  : primary
-- overlay main/raw
sheet raw  size=420  title=Transcript
  editor e  readonly  soft_wrap  language=markdown  : size_full
-- keys
-- stderr
