# DESIGN's form snippet
form prefs  labels=top
  field name  label=Name
    input in  placeholder='Your name'
  field lang  label=Language
    select in  searchable  items=<<END
rs	Rust
go	Go
c	C

    END
  field ok
    button save  label=Save  tag=save  : primary
# items read back as written
rs	Rust
go	Go
c	C
# a select takes only ids in its items
ok
go|
not found
go|
# user events: the input says only that it changed
resync - -
change - prefs/name/in win=main via=user
submit - prefs/name/in win=main
change - prefs/lang/in win=main value=rs via=user
click save prefs/ok/save win=main
# the client reads the text from value
Ada|
rs|
# checkbox values
off|
ok
ok
mixed|
bad value
# a client write is an echo with via=ctl
ok
resync - -
change - cb win=main value=off via=ctl
# controlled=on: the user's change is an event, the value waits for the client
ok
resync - -
change - cb win=main value=on via=user
off|
# secret inputs keep a readable value
hunter2|
# slider ranges and bad numbers
ok
ok
20 80|
bad value
# radio-group items are id label lines
ok
m|
exit=0
