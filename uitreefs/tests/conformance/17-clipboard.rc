#!/bin/rc
# 17-clipboard: DESIGN § Clipboard. clipboard and clipfiles read the
# platform clipboard (headless: one in memory) and writes replace it.
# milestone: M1
# needs: W2 W3 W4
. ./lib.rc

echo 'copied text' >$k/clip
val $k/clip
echo 'line one
line two' >$k/clip
cat $k/clip
echo '/usr/glenda/a.txt
/usr/glenda/b.txt' >$k/clipfiles
cat $k/clipfiles
