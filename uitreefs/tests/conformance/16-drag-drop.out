# the drop file lists accepted types
ok
files text note|
# a text drop: payload in /drag/<n>/data, answered accept
resync - -
drop pick notes win=main type=text drag=7 pt=40,212
hello world
ok
# /drag/7 goes once the request is answered
no
# a drop with no answer is refused after the timeout
no
# starting a drag: dragstart, the client writes the payload, dragend
ok
ok
resync - -
dragstart - card win=main drag=9
note-42
dragend - card win=main drag=9 result=dropped target=notes
exit=0
