ctl path=ctl cmd='window main title=Conformance size=640,480'
ctl path=win/main/ctl cmd='new text a text=hi'
ctl path=win/main/ctl cmd='new input pass flags=secret'
mkdir path=win/main/b
write path=win/main/a/text value=Hello
write path=win/main/a/text len=18
write path=win/main/pass/value value=<secret>
ctl path=win/main/ctl cmd='new input pin flags=secret value=<secret>'
ctl path=win/main/ctl cmd='new input pin2 secret value=<secret>'
ctl path=win/main/ctl cmd='set pass value=<secret>'
write path=win/main/pass/value value=<secret>
ctl path=ctl cmd='set win/main/pin value=<secret>'
write path=win/main/pin/value value=<secret>
ctl path=win/main/ctl cmd='tree pin2 len=31'
remove path=win/main/b
ctl path=win/main/ctl cmd=begin
batch timeout win=main
