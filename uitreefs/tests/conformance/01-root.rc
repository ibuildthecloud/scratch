#!/bin/rc
# 01-root: DESIGN § The tree. The root's files, version, and what a window
# verb adds under win/.
# milestone: M1
# needs: W1 W2 W3 W4
. ./lib.rc

echo '# root'
names $k
echo '# version'
sed 1q $k/version
echo '# main exists from the start, hidden'
names $k/win
echo '# a window'
w $k/ctl window main 'title=''Root test'''
names $k/win
names $k/win/main
echo '# its root node'
val $k/win/main/type
names $k/win/main/over
val $k/win/main/title
