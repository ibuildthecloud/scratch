#!/bin/rc
# hello.rc: the design doc's Greeter. Type a name, press Greet or Enter.
#
#	uitreefs -t Greeter rc hello.rc
#
# Shows: the default main window, a subtree document, input + button
# sharing one inherited tag, submit and click routed by the event's second
# word, reading an input's value file.   Needs: M3
. ./lib.rc
m=$ui/win/main

echo 'set . title=Greeter size=360,170 pos=center resizable=off' >$m/ctl
cat >$m/tree <<'END'
div root  : v_flex size_full p=20 gap=12 bg=background
  div row  tag=greet  : h_flex gap=8
    input name  placeholder='Your name'  : flex_1
    button go  label=Greet  : primary
  text out  text='Who are you?'  : text_lg text_color=muted_foreground
END
echo row/name >$m/focus

# rc's read takes the events file directly: no cat needed.
{ while(ev=`{read}){
	switch($ev(1)^:^$ev(2)){
	case click:greet submit:greet
		n=`{cat $m/row/name/value}
		if(~ $#n 0) n=stranger
		echo 'Hello, '^$"n^'!' >$m/out/text
		echo 'set out : text_lg font_semibold text_color=foreground' >$m/ctl
	}
} } <$ui/events
