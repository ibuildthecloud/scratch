div root  : v_flex size_full p=20 gap=14 bg=background
  div head  : h_flex items_baseline gap=10
    text h  text='ACME Widget Co.'  : text_xl font_semibold
    text sub  text='Weekly payroll, computed in COBOL'  : text_sm text_color=muted_foreground
  form f  labels=side  tag=run
    field name  label=Employee
      input in  placeholder='Grace Hopper'
    field hours  label=Hours
      input in  placeholder=40
    field rate  label='Rate per hour'
      input in  placeholder=25.00
    field go  label=' '
      button run  label='Run payroll'  : primary
  div body  : h_flex flex_1 gap=14 items_stretch
    div left  : v_flex gap=8 w=300
      text t1  text='Pay stub'  : font_semibold
      description-list stub  bordered  columns=1  items=<<END
Employee	-

      END
    div right  : v_flex flex_1 gap=8
      text t2  text=Register  : font_semibold
      table reg  stripe  columns=<<END  : flex_1
emp	Employee	170
hrs	Hours	70	align=right
rate	Rate	80	align=right
net	Net pay	110	align=right

      END
      text total  text='No one paid yet.'  : text_sm text_right text_color=muted_foreground
