ctl path=win/main/ctl cmd='set . title=Payroll size=820,600 min=640,480'
write path=keys value='cmd-enter run'
write path=win/main/tree len=952
write path=win/main/body/right/reg/columns len=97
write path=win/main/body/left/stub/items value='Employee -'
write path=win/main/focus value=f/name/in
ctl path=win/main/ctl cmd='set f/name error=''Who are we paying?'''
write path=win/main/f/name/error value='Who are we paying?'
ctl path=win/main/ctl cmd='set f/hours error=''Hours must be a number'''
write path=win/main/f/hours/error value='Hours must be a number'
ctl path=win/main/ctl cmd='set f/rate error=''Rate must be an amount'''
write path=win/main/f/rate/error value='Rate must be an amount'
ctl path=win/main/ctl cmd='set f/name error='''''
write path=win/main/f/name/error value=''
ctl path=win/main/ctl cmd='set f/hours error='''''
write path=win/main/f/hours/error value=''
ctl path=win/main/ctl cmd='set f/rate error='''''
write path=win/main/f/rate/error value=''
ctl path=win/main/ctl cmd='set body/left/stub items=''Employee ''''Grace Hopper''''
''''Regular, 40.00 h'''' $2,500.00
''''Overtime, 5.00 h at 1.5'''' $468.75
''''Gross pay'''' $2,968.75
''''Federal tax'''' -$593.13
''''FICA, 7.65%'''' -$227.11
''''Net pay'''' $2,148.51
'''
write path=win/main/body/left/stub/items len=175
ctl path=win/main/ctl cmd='set body/right/reg rows=''r1 ''''Grace Hopper'''' 45.00 $62.50 $2,148.51
'''
write path=win/main/body/right/reg/rows value='r1 ''Grace Hopper'' 45.00 $62.50 $2,148.51'
ctl path=win/main/ctl cmd='set body/right/total text=''1 paid. Gross $2,968.75, net $2,148.51.'''
write path=win/main/body/right/total/text value='1 paid. Gross $2,968.75, net $2,148.51.'
ctl path=win/main/ctl cmd='set f/name/in value='''''
write path=win/main/f/name/in/value value=''
ctl path=win/main/ctl cmd='set f/hours/in value='''''
write path=win/main/f/hours/in/value value=''
ctl path=win/main/ctl cmd='set f/rate/in value='''''
write path=win/main/f/rate/in/value value=''
ctl path=win/main/ctl cmd='set . focus=f/name/in'
write path=win/main/focus value=f/name/in
ctl path=win/main/ctl cmd='set f/name error=''Who are we paying?'''
write path=win/main/f/name/error value='Who are we paying?'
ctl path=win/main/ctl cmd='set f/hours error=''Hours must be a number'''
write path=win/main/f/hours/error value='Hours must be a number'
ctl path=win/main/ctl cmd='set f/rate error=''Rate must be an amount'''
write path=win/main/f/rate/error value='Rate must be an amount'
